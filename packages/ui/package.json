{
  "name": "@andrsrxn/ui",
  "version": "0.0.1",
  "description": "Opinionated design system and UI component library for React",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Andrés Raxón",
    "email": "info@andrsrxn.com",
    "url": "https://andrsrxn.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrsrxn/ui.git"
  },
  "homepage": "https://ui.andrsrxn.com",
  "keywords": [
    "ui",
    "components",
    "react",
    "library-components",
    "design-system",
    "tailwind",
    "library"
  ],
  "sideEffects": [
    "dist/**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "dev:demo": "vite dev",
    "build": "pnpm run build:styles && tsdown && echo Build finished.",
    "build:sb": "storybook build",
    "build:styles": "postcss ./src/styles.css -o ./dist/styles.css && echo Build styles finished.",
    "format": "prettier --write . && echo Format finished.",
    "format:check": "prettier --check . && echo Format finished.",
    "lint": "biome check && echo Lint finished.",
    "lint:check": "biome ci && echo Lint finished.",
    "type:check": "tsc --noEmit && echo Typecheck finished.",
    "attw": "pnpm dlx --yes @arethetypeswrong/cli --pack . --profile esm-only --exclude-entrypoints styles.css",
    "publint": "pnpm dlx publint .",
    "test": "vitest",
    "test:check": "vitest run",
    "dep:check": "pnpm dlx knip && echo Dep check finished.",
    "react:check": "pnpm dlx react-doctor@latest . && echo React check finished."
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@andrsrxn/icons": "^7.8.0",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@andrsrxn/ts-config": "workspace:*",
    "@andrsrxn/constants": "workspace:*",
    "@chromatic-com/storybook": "5.6.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/fira-mono": "5.3.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cssnano": "8.0.10",
    "globals": "17.13.0",
    "date-fns": "4.4.0",
    "jsdom": "30.1.3",
    "postcss-cli": "11.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.2",
    "type-coverage": "2.30.1",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
