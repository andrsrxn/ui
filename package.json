{
  "name": "blueprint-design-system",
  "private": true,
  "version": "0.0.1",
  "description": "Opinionated Design System and Component Library for React",
  "author": "andrsrxn",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsdown && pnpm run build:styles && echo Build styles finished.",
    "format": "prettier --write . && echo Format finished.",
    "lint": "biome check && echo Lint finished.",
    "lint:fix": "biome check --write && echo Lint fixed.",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json && echo Typecheck finished.",
    "typecoverage": "pnpm dlx type-coverage -at-least=99 && echo Typecoverage finished.",
    "depcheck": "pnpm dlx knip && echo Depcheck finished.",
    "preview": "vite preview",
    "sb": "storybook dev -p 6006 --no-open",
    "build:sb": "storybook build",
    "build:styles": "postcss ./src/globals.css -o ./dist/styles.css && echo Build styles finished.",
    "doctor": "pnpm dlx react-doctor@latest . && echo Doctor finished.",
    "generate-icons": "node ./scripts/generate-icons.js && node ./scripts/generate-icons-index.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "./src/globals.css"
  ],
  "dependencies": {
    "@fontsource/fira-mono": "5.2.7",
    "@fontsource/fira-sans": "5.2.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0"
  },
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@chromatic-com/storybook": "5.1.1",
    "@storybook/addon-a11y": "10.3.5",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-themes": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.3",
    "@vitest/coverage-v8": "4.1.3",
    "cssnano": "7.1.5",
    "globals": "17.4.0",
    "playwright": "1.58.2",
    "postcss-cli": "11.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "storybook": "10.3.5",
    "tailwind-animations": "1.0.1",
    "tailwindcss": "4.2.2",
    "tsdown": "0.21.7",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.3"
  }
}
