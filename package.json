{
  "name": "andrsrxn-ui-monorepo",
  "private": true,
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:ui": "turbo run dev --filter=@andrsrxn/ui",
    "sb": "turbo run sb",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=@andrsrxn/ui",
    "build:docs": "turbo run build --filter=docs",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "prettier --write . && echo Format finished.",
    "format:check": "prettier --check . && echo Format finished.",
    "type:check": "turbo run type:check",
    "dep:check": "turbo run dep:check --continue",
    "react:check": "turbo run react:check --continue",
    "test": "turbo run test",
    "test:check": "turbo run test:check",
    "vul:check": "pnpm dlx is-my-node-vulnerable",
    "audit": "pnpm audit",
    "stats": "onefetch",
    "changeset": "changeset",
    "version-package": "changeset version || true && pnpm install --no-frozen-lockfile",
    "release": "pnpm build:icons && changeset publish",
    "generate-icons": "turbo run generate-icons",
    "generate-flags": "turbo run generate-flags",
    "generate-raw-metadata": "turbo run generate-raw-metadata",
    "attw": "turbo run attw",
    "publint": "turbo run publint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "lefthook": "2.2.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
