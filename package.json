{
  "name": "@andrsrxn/ui",
  "private": true,
  "version": "0.0.1",
  "description": "Opinionated design system and component library for React",
  "author": {
    "name": "andrsrxn",
    "email": "info@andrsrxn.com",
    "url": "https://ui.andrsrxn.com"
  },
  "keywords": [
    "ui",
    "components",
    "react",
    "library-components",
    "design-system",
    "tailwind",
    "library"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrsrxn/ui.git"
  },
  "bugs": {
    "url": "https://github.com/andrsrxn/ui/issues"
  },
  "homepage": "https://ui.andrsrxn.com",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "./src/globals.css"
  ],
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "preview": "vite preview",
    "build": "pnpm run build:styles && tsdown && echo Build styles finished.",
    "build:sb": "storybook build",
    "build:styles": "postcss ./src/globals.css -o ./dist/styles.css && echo Build styles finished.",
    "format": "prettier --write . && echo Format finished.",
    "lint": "biome check && echo Lint finished.",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json && echo Typecheck finished.",
    "test": "vitest",
    "generate-icons": "node ./scripts/generate-icons.js && node ./scripts/generate-icons-index.js",
    "typecoverage": "pnpm dlx type-coverage -at-least=99 && echo Typecoverage finished.",
    "depcheck": "pnpm dlx knip && echo Depcheck finished.",
    "doctor": "pnpm dlx react-doctor@latest . && echo Doctor finished."
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "radix-ui": "1.6.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@chromatic-com/storybook": "5.2.1",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@fontsource/fira-mono": "5.2.7",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/addon-themes": "10.4.2",
    "@storybook/addon-vitest": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.4",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "cssnano": "7.1.9",
    "globals": "17.6.0",
    "happy-dom": "20.10.4",
    "playwright": "1.60.0",
    "postcss-cli": "11.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "server-only": "0.0.1",
    "storybook": "10.4.2",
    "tailwindcss": "4.3.0",
    "tsdown": "0.22.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
